if(NOT EXISTS "${REVCL_BINARY}")
  message(FATAL_ERROR "Missing native ELF: ${REVCL_BINARY}")
endif()
file(READ "${REVCL_SHA_FILE}" checksum)
string(REGEX MATCH "^[0-9a-fA-F]+" expected "${checksum}")
string(LENGTH "${expected}" length)
if(NOT length EQUAL 64 OR NOT expected MATCHES "^[0-9a-fA-F]+$")
  message(FATAL_ERROR "Invalid SHA-256 reference: ${REVCL_SHA_FILE}")
endif()
file(SHA256 "${REVCL_BINARY}" actual)
if(NOT "${actual}" STREQUAL "${expected}")
  message(FATAL_ERROR "Native VCL SHA-256 mismatch: expected ${expected}, got ${actual}")
endif()
message(STATUS "Native VCL SHA-256 verified: ${actual}")
