{
  "version": 5,
  "cmakeMinimumRequired": {"major": 3, "minor": 23, "patch": 0},
  "configurePresets": [
    {
      "name": "linux-gcc",
      "displayName": "Native Linux (GCC, x86_64 or ARM64)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/tmp/cmake/linux-gcc",
      "cacheVariables": {"CMAKE_CXX_COMPILER": "g++"}
    },
    {
      "name": "linux-clang",
      "displayName": "Native Linux (Clang, x86_64 or ARM64)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/tmp/cmake/linux-clang",
      "cacheVariables": {"CMAKE_CXX_COMPILER": "clang++"}
    },
    {
      "name": "macos",
      "displayName": "Native macOS (Apple Clang, arm64 or x86_64)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/tmp/cmake/macos",
      "cacheVariables": {}
    },
    {
      "name": "historical",
      "displayName": "Historical RH9 GCC 3.2.2 (Docker compiler)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/tmp/cmake/historical",
      "cacheVariables": {
        "REVCL_HISTORICAL": "ON",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/rh9.cmake"
      }
    }
  ],
  "buildPresets": [
    {"name":"macos","configurePreset":"macos","jobs":2},
    {"name":"linux-gcc","configurePreset":"linux-gcc","jobs":2},
    {"name":"linux-clang","configurePreset":"linux-clang","jobs":2},
    {"name":"historical","configurePreset":"historical","jobs":2}
  ],
  "testPresets": [
    {"name":"macos","configurePreset":"macos","output":{"outputOnFailure":true}},
    {"name":"linux-gcc","configurePreset":"linux-gcc","output":{"outputOnFailure":true}},
    {"name":"linux-clang","configurePreset":"linux-clang","output":{"outputOnFailure":true}},
    {"name":"historical","configurePreset":"historical","output":{"outputOnFailure":true}}
  ]
}
