# Check structural build invariants without requiring Python or Docker.
cmake_minimum_required(VERSION 3.23)
if(NOT IS_DIRECTORY "${REVCL_SOURCE_DIR}")
  message(FATAL_ERROR "REVCL_SOURCE_DIR is not a directory: ${REVCL_SOURCE_DIR}")
endif()
include("${REVCL_SOURCE_DIR}/config/vcl-link-order.cmake")
list(LENGTH VCL_SOURCES count)
if(NOT count EQUAL 131)
  message(FATAL_ERROR "Expected 131 source owners, found ${count}")
endif()
list(GET VCL_SOURCES 0 first)
if(NOT first STREQUAL "src/main.cpp")
  message(FATAL_ERROR "Original source order does not start with main.cpp")
endif()
file(GLOB all_sources RELATIVE "${REVCL_SOURCE_DIR}"
  "${REVCL_SOURCE_DIR}/src/*.cpp")
list(LENGTH all_sources owner_count)
if(NOT owner_count EQUAL 131)
  message(FATAL_ERROR "Source tree contains ${owner_count} owners instead of 131")
endif()
foreach(owner IN LISTS VCL_SOURCES)
  list(FIND all_sources "${owner}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "Missing source owner: ${owner}")
  endif()
endforeach()
set(unique_owners ${VCL_SOURCES})
list(REMOVE_DUPLICATES unique_owners)
list(LENGTH unique_owners unique_count)
if(NOT unique_count EQUAL 131)
  message(FATAL_ERROR "Link order contains duplicate source owners")
endif()

file(READ "${REVCL_SOURCE_DIR}/config/build.json" build_config)
string(JSON flag_count LENGTH "${build_config}" cxxflags)
string(JSON first_flag GET "${build_config}" cxxflags 0)
string(JSON second_flag GET "${build_config}" cxxflags 1)
string(JSON third_flag GET "${build_config}" cxxflags 2)
string(JSON unit_count LENGTH "${build_config}" units)
if(NOT flag_count EQUAL 3 OR NOT first_flag STREQUAL "-O2"
    OR NOT second_flag STREQUAL "-frename-registers"
    OR NOT third_flag STREQUAL "-fmerge-all-constants"
    OR unit_count GREATER 5)
  message(FATAL_ERROR "Historical GCC common flags or per-file exceptions regressed")
endif()
file(READ "${REVCL_SOURCE_DIR}/tools/rh9/vcl.sha256" sha_manifest)
if(NOT sha_manifest STREQUAL
    "83bee75205b5b0f37dbefc2c2769eba2c353befa532472c49aedb2ebaf168274  tmp/cmake/historical/vcl.stripped\n")
  message(FATAL_ERROR "Historical original ELF checksum or output path changed")
endif()

file(READ "${REVCL_SOURCE_DIR}/CMakePresets.json" presets)
foreach(group configurePresets buildPresets testPresets)
  string(JSON preset_count LENGTH "${presets}" ${group})
  if(NOT preset_count EQUAL 4)
    message(FATAL_ERROR "${group}: expected four presets, got ${preset_count}")
  endif()
  set(names)
  foreach(i RANGE 0 3)
    string(JSON name GET "${presets}" ${group} ${i} name)
    list(APPEND names "${name}")
  endforeach()
  foreach(required historical linux-gcc linux-clang macos)
    if(NOT required IN_LIST names)
      message(FATAL_ERROR "${group}: missing ${required} preset")
    endif()
  endforeach()
endforeach()

file(READ "${REVCL_SOURCE_DIR}/CMakeLists.txt" cmake_file)
if(cmake_file MATCHES "REVCL_MODERN_32BIT" OR cmake_file MATCHES "-m32")
  message(FATAL_ERROR "Modern CMake build unexpectedly forces 32-bit")
endif()
if(cmake_file MATCHES "find_package\\(Python3" OR cmake_file MATCHES "Python3_EXECUTABLE")
  message(FATAL_ERROR "The native CMake/CTest workflow unexpectedly requires Python")
endif()
foreach(workflow vcl-modern vcl-byte-exact)
  file(READ "${REVCL_SOURCE_DIR}/.github/workflows/${workflow}.yml" ci_yaml)
  if(ci_yaml MATCHES "actions/setup-python" OR ci_yaml MATCHES "pip install"
      OR ci_yaml MATCHES "Python3_EXECUTABLE")
    message(FATAL_ERROR "${workflow}: CI unexpectedly installs or invokes Python")
  endif()
  if(NOT ci_yaml MATCHES "--parallel")
    message(FATAL_ERROR "${workflow}: CMake and CTest parallelism was removed")
  endif()
endforeach()
file(READ "${REVCL_SOURCE_DIR}/src/vcl_portability.h" shim)
file(READ "${REVCL_SOURCE_DIR}/src/Block.h" block_header)
if(NOT shim MATCHES "typedef intptr_t VclPtrWord"
    OR NOT shim MATCHES "typedef uintptr_t VclUPtrWord"
    OR NOT block_header MATCHES "class Block : public ScheduleTable")
  message(FATAL_ERROR "Portable native layout declarations changed")
endif()

file(READ "${REVCL_SOURCE_DIR}/tests/oracle/cases.json" cases)
file(READ "${REVCL_SOURCE_DIR}/tests/oracle/expected_stdout_sha256.json" hashes)
string(JSON ncases LENGTH "${cases}")
set(standalone_count 0)
foreach(i RANGE 0 11)
  string(JSON name GET "${cases}" ${i} name)
  string(JSON archived ERROR_VARIABLE archive_error GET "${cases}" ${i} archive)
  if(NOT archive_error)
    continue()
  endif()
  math(EXPR standalone_count "${standalone_count} + 1")
  string(JSON digest GET "${hashes}" "${name}" stdout_sha256)
  string(LENGTH "${digest}" digest_size)
  if(NOT digest_size EQUAL 64 OR NOT digest MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "${name}: invalid output SHA-256")
  endif()
endforeach()
if(NOT ncases EQUAL 12 OR NOT standalone_count EQUAL 11)
  message(FATAL_ERROR "Expected 11 standalone and one archived VCL fixture")
endif()
message(STATUS "Project invariants verified: 131 owners, 11 oracle fixtures, four presets")
