{
  "cxxflags": [
    "-O2",
    "-frename-registers",
    "-fmerge-all-constants"
  ],
  "units": {
    "src/RegWeb.cpp": [
      "-fno-weak"
    ],
    "src/wrangleCore.cpp": [
      "-fno-cse-follow-jumps"
    ],
    "src/wrangle.cpp": [
      "-fno-cse-follow-jumps"
    ],
    "src/doPostOpt.cpp": [
      "-mno-fp-ret-in-387"
    ],
    "src/infoList.cpp": [
      "-finline-functions"
    ]
  }
}
